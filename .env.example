# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Only needed for databricks/deploy_to_databricks.py and
# snowflake/deploy_to_snowflake.py (neither is part of the local demo).

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Optional. Defaults to "sales_demo_metrics" if unset. Only matters if you're
# sharing a catalog/schema with other people (e.g. a workshop) - set this to
# something unique per person so your deploy doesn't overwrite someone else's.
DATABRICKS_METRIC_VIEW_NAME=

# snowflake/deploy_to_snowflake.py - username+password auth. The script
# creates its own warehouse/database/schema/stage, nothing else needed.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Optional - falls back to your default role. Needed if that default can't
# CREATE WAREHOUSE/DATABASE.
SNOWFLAKE_ROLE=
