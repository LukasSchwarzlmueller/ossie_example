+  /**
+   * Maps relationship columns (declared field names) to the source columns those fields read. A
+   * name that is not a declared field is kept as-is. A field whose expression is not a plain
+   * column is kept by name, with a warning, since it can't be used in a join condition.
+   */
+  private static List<String> joinColumns(List<String> names, Map<String, Object> dataset,
+      String datasetName, Notices notices) {
+    List<String> out = new ArrayList<>();
+    for (String name : names) {
+      String column = name;
+      for (Object o : asList(get(dataset, "fields"))) {
+        if (!(o instanceof Map)) {
+          continue;
+        }
+        @SuppressWarnings("unchecked")
+        Map<String, Object> f = (Map<String, Object>) o;
+        if (name.equals(str(get(f, "name")))) {
+          String scope = "field '" + datasetName + "." + name + "'";
+          String expr = pickExpression(get(f, "expression"), scope);
+          if (expr != null && isSimpleIdentifier(expr.trim())) {
+            column = expr.trim();
+          } else if (expr != null) {
+            notices.warn(scope, "join column is not a plain column expression; joining on the "
+                + "field name as-is");
+          }
+          break;
+        }
+      }
+      out.add(column);
+    }
+    return out;
+  }
